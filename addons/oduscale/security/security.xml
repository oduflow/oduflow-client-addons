<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="group_manager" model="res.groups">
        <field name="name">Manage employee VPN access</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('oduscale.group_manager'))]"/>
    </record>
    <record id="server_company_rule" model="ir.rule">
        <field name="name">Oduscale servers by company</field>
        <field name="model_id" ref="model_oduscale_server"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="connection_company_rule" model="ir.rule">
        <field name="name">Oduscale connections by company</field>
        <field name="model_id" ref="model_oduscale_connection"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="device_company_rule" model="ir.rule">
        <field name="name">Oduscale devices by company</field>
        <field name="model_id" ref="model_oduscale_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="key_company_rule" model="ir.rule">
        <field name="name">Oduscale keys by company</field>
        <field name="model_id" ref="model_oduscale_key"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
