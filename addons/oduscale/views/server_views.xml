<odoo>
    <record id="server_list" model="ir.ui.view">
        <field name="name">oduscale.server.list</field>
        <field name="model">oduscale.server</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="login_url" widget="url"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="last_sync"/>
                <field name="last_error"/>
            </list>
        </field>
    </record>
    <record id="server_form" model="ir.ui.view">
        <field name="name">oduscale.server.form</field>
        <field name="model">oduscale.server</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object" string="Test connection" class="btn-primary"/>
                    <button name="action_sync" type="object" string="Synchronize"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Headscale server"/></h1></div>
                    <group>
                        <group string="Connection">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="api_url"/>
                            <field name="api_key_env" groups="base.group_system"/>
                            <field name="login_url" widget="url"/>
                            <field name="odoo_url" widget="url"/>
                        </group>
                        <group string="Enrollment and synchronization">
                            <field name="key_lifetime_minutes"/>
                            <field name="last_sync"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">Enrollment keys are single-use. VPN policy and the gateway determine which services employees can reach. The Odoo login is still required.</div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="server_action" model="ir.actions.act_window">
        <field name="name">Headscale Servers</field>
        <field name="res_model">oduscale.server</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
