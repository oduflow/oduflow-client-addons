msgid "Actions performed after switching are recorded as the selected user."
msgstr "Działania po przełączeniu są rejestrowane jako wykonane przez wybranego użytkownika."

msgid "Cancel"
msgstr "Anuluj"

msgid "OduLogin Session Service"
msgstr "Usługa sesji OduLogin"

msgid "Only active internal users can be selected."
msgstr "Można wybrać tylko aktywnych użytkowników wewnętrznych."

msgid "Only settings administrators can switch users."
msgstr "Tylko administratorzy Ustawień mogą przełączać użytkowników."

msgid "Return to your administrator account before switching again."
msgstr "Przed kolejnym przełączeniem wróć do konta administratora."

msgid "Return to %s"
msgstr "Wróć do %s"

msgid "Return to administrator"
msgstr "Wróć do administratora"

msgid "Select a user other than yourself."
msgstr "Wybierz użytkownika innego niż Ty."

msgid "Select an existing user."
msgstr "Wybierz istniejącego użytkownika."

msgid "The original administrator account is no longer active."
msgstr "Pierwotne konto administratora nie jest już aktywne."

msgid "The technical superuser cannot be selected."
msgstr "Nie można wybrać superużytkownika technicznego."

msgid "This session is not switched to another user."
msgstr "Ta sesja nie jest przełączona na innego użytkownika."

msgid "Switch User"
msgstr "Przełącz użytkownika"

msgid "Switch to Another User"
msgstr "Przełącz na innego użytkownika"

msgid "User switching is only available in an authenticated web session."
msgstr "Przełączanie użytkownika jest dostępne tylko w uwierzytelnionej sesji internetowej."

msgid "User"
msgstr "Użytkownik"
