<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="odulogin.OduLoginSystray">
        <button
            t-if="session.odulogin_is_switched"
            type="button"
            class="btn btn-link o_nav_entry"
            t-att-title="switchBackTitle"
            t-att-aria-label="switchBackTitle"
            t-att-disabled="state.busy"
            t-on-click="switchBack"
        >
            <i class="fa fa-sign-out" aria-hidden="true"/>
        </button>
        <button
            t-else=""
            type="button"
            class="btn btn-link o_nav_entry"
            title="Switch User"
            aria-label="Switch User"
            t-on-click="openSwitchWizard"
        >
            <i class="fa fa-sign-in" aria-hidden="true"/>
        </button>
    </t>
</templates>
