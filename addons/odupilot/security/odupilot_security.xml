        <field name="model_id" ref="model_odupilot_session"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('channel_id.channel_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="perm_read" eval="True"/>
