<odoo>
    <record id="view_odupilot_profile_tree" model="ir.ui.view">
        <field name="name">odupilot.profile.tree</field>
        <field name="model">odupilot.profile</field>
        <field name="arch" type="xml">
            <tree string="OduPilot Profiles">
                <field name="name"/>
                <field name="code"/>
                <field name="workspace_type"/>
                <field name="model"/>
                <field name="reasoning_effort"/>
                <field name="max_sessions"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_odupilot_profile_form" model="ir.ui.view">
        <field name="name">odupilot.profile.form</field>
        <field name="model">odupilot.profile</field>
        <field name="arch" type="xml">
            <form string="OduPilot Profile">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="workspace_type"/>
                            <field name="model"/>
                            <field name="reasoning_effort"/>
                            <field name="litellm_api_key" password="True"/>
                            <field name="max_sessions"/>
                            <field name="default_agent_id" options="{'no_create_edit': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agents">
                            <field name="agent_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                        </page>
                        <page string="Users" groups="base.group_system">
                            <field name="user_ids" readonly="1" context="{'active_test': False}">
                                <tree create="false" delete="false">
                                    <field name="name"/>
                                    <field name="login"/>
                                    <field name="company_id"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Developer workspace" groups="base.group_system" attrs="{'invisible': [('workspace_type', '!=', 'worktree')]}">
                            <group>
                                <field name="developer_repo_url" placeholder="https://github.com/org/repository.git"/>
                                <field name="developer_base_branch"/>
                                <field name="developer_github_pat" password="True"/>
                                <field name="developer_environment_mcp_server_id" options="{'no_create_edit': True}"/>
                                <field name="developer_environment_template_name" attrs="{'invisible': [('developer_environment_mcp_server_id', '=', False)], 'required': [('developer_environment_mcp_server_id', '!=', False)]}"/>
                                <field name="developer_environment_odoo_image" attrs="{'invisible': [('developer_environment_mcp_server_id', '=', False)], 'required': [('developer_environment_mcp_server_id', '!=', False)]}"/>
                                <field name="developer_bootstrap_prompt" placeholder="Optional instructions for the environment bootstrap agent..." attrs="{'invisible': [('developer_environment_mcp_server_id', '=', False)]}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odupilot_profile" model="ir.actions.act_window">
        <field name="name">OduPilot Profiles</field>
        <field name="res_model">odupilot.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
