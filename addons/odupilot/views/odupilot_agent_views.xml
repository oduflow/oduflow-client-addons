<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_odupilot_agent_tree" model="ir.ui.view">
        <field name="name">odupilot.agent.tree</field>
        <field name="model">odupilot.agent</field>
        <field name="arch" type="xml">
            <list string="AI Agents" create="false" delete="false">
                <field name="name"/>
                <field name="description"/>
                <field name="agent_type"/>
                <field name="active" invisible="1"/>
                <button name="action_start_chat" type="object" string="Start Chat" class="oe_highlight"/>
            </list>
        </field>
    </record>

    <record id="view_odupilot_agent_tree_admin" model="ir.ui.view">
        <field name="name">odupilot.agent.tree.admin</field>
        <field name="model">odupilot.agent</field>
        <field name="priority" eval="10"/>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="arch" type="xml">
            <list string="AI Agents">
                <field name="name"/>
                <field name="code"/>
                <field name="agent_type"/>
                <field name="mcp_only"/>
                <field name="profile_ids" widget="many2many_tags"/>
                <field name="active"/>
                <button name="action_start_chat" type="object" string="Start Chat" class="oe_highlight"/>
            </list>
        </field>
    </record>

    <record id="view_odupilot_agent_form" model="ir.ui.view">
        <field name="name">odupilot.agent.form</field>
        <field name="model">odupilot.agent</field>
        <field name="arch" type="xml">
            <form string="AI Agent">
                <header>
                    <button name="action_start_chat" type="object" string="Start Chat" class="oe_highlight"/>
                    <button name="action_configure_mcp_methods" type="object" string="Configure MCP Methods" groups="base.group_system" invisible="agent_type != 'payment_reconciliation'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code" groups="base.group_system"/>
                            <field name="agent_type" groups="base.group_system"/>
                            <field name="active" groups="base.group_system"/>
                        </group>
                        <group groups="base.group_system">
                            <field name="profile_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                            <field name="mcp_only"/>
                            <field name="mcp_server_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                        </group>
                    </group>
                    <field name="description"/>
                    <notebook groups="base.group_system">
                        <page string="Instructions">
                            <field name="system_prompt" placeholder="Define the agent role, workflow, and business boundaries..."/>
                        </page>
                        <page string="Permissions">
                            <field name="ruleset_json" widget="text"/>
                        </page>
                        <page string="Sessions">
                            <field name="session_ids" readonly="1">
                                <list create="false" delete="false">
                                    <field name="create_date"/>
                                    <field name="user_id"/>
                                    <field name="state"/>
                                    <field name="channel_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odupilot_agent_select" model="ir.actions.act_window">
        <field name="name">AI Agent Chat</field>
        <field name="res_model">odupilot.agent</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'create': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI agents are available</p>
            <p>Ask an administrator to configure an agent for your OduPilot profile.</p>
        </field>
    </record>

    <record id="action_odupilot_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">odupilot.agent</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
