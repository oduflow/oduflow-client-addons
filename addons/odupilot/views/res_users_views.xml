<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_users_form_odupilot" model="ir.ui.view">
        <field name="name">res.users.form.odupilot</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="inside">
                <group string="OduPilot" groups="base.group_system">
                    <field name="odupilot_profile_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
