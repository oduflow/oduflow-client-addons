<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_odupilot_command_search" model="ir.ui.view">
        <field name="name">odupilot.command.search</field>
        <field name="model">odupilot.command</field>
        <field name="arch" type="xml">
            <search string="OduPilot Commands">
                <field name="session_id"/>
                <field name="command_type"/>
                <field name="external_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="processing" string="Processing" domain="[('state', '=', 'processing')]"/>
                <filter name="errors" string="Errors" domain="[('state', '=', 'error')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Command Type" context="{'group_by': 'command_type'}"/>
                    <filter name="group_session" string="Session" context="{'group_by': 'session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_odupilot_command_tree" model="ir.ui.view">
        <field name="name">odupilot.command.tree</field>
        <field name="model">odupilot.command</field>
        <field name="arch" type="xml">
            <tree string="OduPilot Commands" create="false" delete="false" decoration-danger="state == 'error'" decoration-warning="state == 'processing'">
                <field name="create_date"/>
                <field name="session_id"/>
                <field name="command_type"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="processing_started_at"/>
                <field name="completed_at"/>
                <field name="duration_seconds"/>
                <field name="external_id" optional="hide"/>
                <field name="error" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_odupilot_command_form" model="ir.ui.view">
        <field name="name">odupilot.command.form</field>
        <field name="model">odupilot.command</field>
        <field name="arch" type="xml">
            <form string="OduPilot Command" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="session_id"/>
                            <field name="command_type"/>
                            <field name="user_id"/>
                            <field name="state"/>
                            <field name="attempts"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="processing_started_at"/>
                            <field name="completed_at"/>
                            <field name="duration_seconds"/>
                            <field name="next_attempt_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="external_id"/>
                        <field name="source_message_id"/>
                        <field name="recovery_id"/>
                        <field name="origin_model"/>
                        <field name="origin_res_id"/>
                    </group>
                    <notebook>
                        <page string="Error">
                            <field name="error" nolabel="1"/>
                        </page>
                        <page string="Payload">
                            <field name="payload" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odupilot_command" model="ir.actions.act_window">
        <field name="name">OduPilot Commands</field>
        <field name="res_model">odupilot.command</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_odupilot_runtime_form" model="ir.ui.view">
        <field name="name">odupilot.runtime.form</field>
        <field name="model">odupilot.runtime</field>
        <field name="arch" type="xml">
            <form string="OduPilot Monitoring" create="false" edit="false" delete="false">
                <header>
                    <field name="status" widget="badge" decoration-success="status == 'healthy'" decoration-warning="status == 'degraded'" decoration-danger="status == 'offline'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_pending_commands" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="pending_command_count" widget="statinfo" string="Pending"/>
                        </button>
                        <button name="action_open_processing_commands" type="object" class="oe_stat_button" icon="fa-spinner">
                            <field name="processing_command_count" widget="statinfo" string="Processing"/>
                        </button>
                        <button name="action_open_error_commands" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="error_command_count" widget="statinfo" string="Errors"/>
                        </button>
                        <button name="action_open_sessions" type="object" class="oe_stat_button" icon="fa-comments">
                            <field name="busy_session_count" widget="statinfo" string="Busy Sessions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Attention" bg_color="bg-danger" invisible="status == 'healthy'"/>
                    <h1><field name="name"/></h1>
                    <group string="Runtime">
                        <group>
                            <field name="last_heartbeat_at"/>
                            <field name="heartbeat_age_seconds"/>
                            <field name="bridge_started_at"/>
                            <field name="bridge_version"/>
                            <field name="event_queue_size"/>
                        </group>
                        <group>
                            <field name="opencode_healthy"/>
                            <field name="opencode_version"/>
                            <field name="opencode_latency_ms"/>
                            <field name="health_error"/>
                            <field name="last_error_at"/>
                        </group>
                    </group>
                    <group string="Commands and Sessions">
                        <group>
                            <field name="stuck_command_count"/>
                            <field name="error_command_24h_count"/>
                            <field name="waiting_approval_count"/>
                        </group>
                        <group>
                            <field name="completed_command_24h_count"/>
                            <field name="average_duration_24h"/>
                            <field name="maximum_duration_24h"/>
                        </group>
                    </group>
                    <group string="Last Runtime Error" invisible="last_error == False">
                        <field name="last_error_state" nolabel="1" widget="badge" decoration-success="not health_error" decoration-danger="health_error"/>
                        <field name="last_error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odupilot_runtime" model="ir.actions.act_window">
        <field name="name">OduPilot Monitoring</field>
        <field name="res_model">odupilot.runtime</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="odupilot.runtime_main"/>
        <field name="target">current</field>
    </record>
</odoo>
