ODUPILOT_WORKSPACE_VOLUME=odupilot-workspace
ODUPILOT_UID=1000
ODUPILOT_GID=1000
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=replace-with-a-long-random-secret
OPENCODE_MEM_LIMIT=4g

ODOO_URL=https://odoo.example.com
ODOO_DATABASE=production
# Dedicated service user with the OduPilot Bridge Service group and no other
# access rights. Do not use an administrator account.
ODOO_LOGIN=odupilot-bridge
ODOO_PASSWORD=replace-with-a-long-random-secret

ODUPILOT_EVENT_BATCH_SIZE=50
ODUPILOT_EVENT_FLUSH_SECONDS=0.5
