ARG OPENCODE_IMAGE=ghcr.io/anomalyco/opencode:1.18.9@sha256:f958f81ae08f5f9bf16e2bb3cd6e472b2ce6aa024a741c3e2dec1ed89ea69232
FROM ${OPENCODE_IMAGE}

ARG ODUPILOT_BRIDGE_VERSION=unknown
ARG ANYDOC_VERSION=0.1.9

USER 0:0
RUN apk add --no-cache ca-certificates curl git openssh-client su-exec nodejs \
    && apk add --no-cache --virtual .anydoc-build npm \
    && npm install -g --no-fund --no-audit \
        "@firecrawl/anydoc@${ANYDOC_VERSION}" \
    && npm cache clean --force \
    && apk del .anydoc-build \
    && anydoc --version

COPY opencode-entrypoint.sh /usr/local/bin/odupilot-opencode-entrypoint
RUN chmod 0755 /usr/local/bin/odupilot-opencode-entrypoint

ENTRYPOINT ["/usr/local/bin/odupilot-opencode-entrypoint"]
CMD ["serve", "--hostname", "0.0.0.0", "--port", "4096"]
