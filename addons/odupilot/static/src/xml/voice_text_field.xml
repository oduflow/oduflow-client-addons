<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve">
    <t t-name="odupilot.VoiceTextField" owl="1">
        <div class="o_ai_voice_text_field">
            <t t-if="!props.readonly">
                <textarea class="o_input o_ai_voice_text_input" t-att-placeholder="props.placeholder" t-att-value="value" t-on-input="onInput"/>
                <div t-if="canRecord" class="o_ai_voice_text_controls">
                    <button t-if="!state.recording and !state.transcribing" type="button" class="btn btn-sm btn-secondary" t-on-click="onRecord"><i class="fa fa-microphone"/> Dictate</button>
                    <button t-if="state.recording" type="button" class="btn btn-sm btn-danger" t-on-click="onStop"><i class="fa fa-stop"/> Stop</button>
                    <span t-if="state.recording" t-esc="duration"/>
                    <span t-if="state.transcribing" class="text-muted"><i class="fa fa-spinner fa-spin"/> Transcribing…</span>
                </div>
                <div t-if="state.error" class="text-danger" t-esc="state.error"/>
            </t>
            <span t-else="" t-esc="value"/>
        </div>
    </t>
</templates>