<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_odupilot_developer_wizard_form" model="ir.ui.view">
        <field name="name">odupilot.developer.wizard.form</field>
        <field name="model">odupilot.developer.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Developer">
                <group>
                    <field name="source_context_json" invisible="1"/>
                    <field name="source_summary" readonly="1"/>
                </group>
                <field name="prompt" nolabel="1" widget="ai_voice_text" class="o_ai_voice_text_field" placeholder="Describe what the AI developer should change or investigate..."/>
                <div class="text-muted">
                    AI first checks Prod Odoo and available documentation. If a code change is needed, the request is assigned to the responsible developer. A new developer chat and Git worktree will be created, and the current screen is sent as invocation context.
                </div>
                <footer>
                    <button name="action_send" type="object" string="Send to AI Developer" class="btn-primary" data-hotkey="q"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_odupilot_developer_wizard" model="ir.actions.act_window">
        <field name="name">AI Developer</field>
        <field name="res_model">odupilot.developer.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odupilot_developer_wizard_form"/>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
