ODUMCP_ODOO_URL=http://127.0.0.1:8069
# Optional when the reverse proxy routes WebSockets to a separate evented upstream.
# ODUMCP_EVENTS_URL=ws://127.0.0.1:8072/odumcp/v1/events
ODUMCP_HOST=127.0.0.1
ODUMCP_PORT=8000
ODUMCP_MCP_PATH=/mcp
ODUMCP_REQUEST_TIMEOUT_SECONDS=30
ODUMCP_VERIFY_TLS=true
ODUMCP_MAX_RESPONSE_BYTES=10485760
ODUMCP_TOOL_GROUPS=core
ODUMCP_LOG_LEVEL=INFO
ODUMCP_LOG_FORMAT=json
ODUMCP_IDENTITY_CACHE_SECONDS=10
ODUMCP_USER_LOCK_TIMEOUT_SECONDS=5
ODUMCP_RETRY_ATTEMPTS=3
ODUMCP_CIRCUIT_FAILURE_THRESHOLD=5
ODUMCP_CIRCUIT_RESET_SECONDS=30
ODUMCP_EVENTS_ENABLED=true
ODUMCP_EVENT_REFRESH_SECONDS=240
