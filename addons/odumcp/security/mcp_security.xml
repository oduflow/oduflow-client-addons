<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="module_category_odumcp" model="ir.module.category">
        <field name="name">OduMCP</field>
        <field name="sequence">90</field>
        <field name="parent_id" ref="base.module_category_administration"/>
    </record>

    <record id="privilege_odumcp" model="res.groups.privilege"><field name="name">OduMCP</field><field name="category_id" ref="module_category_odumcp"/></record><record id="group_mcp_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can inspect MCP profiles, approvals, user MCP settings, and immutable audit records.</field>
    <field name="privilege_id" ref="privilege_odumcp"/></record>

    <record id="group_mcp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('odumcp.group_mcp_auditor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Can configure MCP policies, assign user access, and approve change plans.</field>
    <field name="privilege_id" ref="privilege_odumcp"/></record>
</odoo>
