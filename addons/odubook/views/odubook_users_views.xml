<odoo>
    <record id="view_users_form_odubook" model="ir.ui.view">
        <field name="name">res.users.form.odubook</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lang']/.." position="after">
                <field name="odubook_lang_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_odubook" model="ir.ui.view">
        <field name="name">res.users.preferences.form.odubook</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lang']/.." position="after">
                <field name="odubook_lang_id"/>
            </xpath>
        </field>
    </record>
</odoo>
